{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Dashboard API (FastAPI)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "core.api:app", "--host", "0.0.0.0", "--port", "8080"],
      "port": 8080
    },
    {
      "name": "Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--host", "0.0.0.0"],
      "port": 5173,
      "cwd": "dashboard"
    },
    {
      "name": "Pytest (Unit Tests)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "pytest", "tests/unit/", "-v", "--tb=short"],
      "port": 0
    }
  ]
}
